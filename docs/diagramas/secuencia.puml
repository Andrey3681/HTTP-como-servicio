@startuml secuencia
skinparam monochrome true
skinparam shadowing false
skinparam defaultTextAlignment left

title Diagrama de Secuencia - Aprovisionamiento de una Instancia

actor Usuario
participant "API / Consola" as API
participant "Orquestador" as Orq
participant "VirtualBox" as VBox
participant "ns (Bind9)" as DNS
participant "Instancia Apache" as VM

Usuario -> API : POST /api/instancias (nombre, .zip)
API -> Orq : validar entrada y paquete
Orq -> VBox : createvm + disco diferencial + semilla cloud-init
VBox --> Orq : VM creada
Orq -> VBox : startvm
VBox --> Orq : VM en ejecución
Orq -> VBox : concesión DHCP / tabla ARP
VBox --> Orq : IP asignada (DHCP .100-.199)
Orq -> DNS : nsupdate (registro A)
DNS --> Orq : registro aplicado
Orq -> VM : esperar SSH con la clave del entorno
VM --> Orq : SSH disponible
Orq -> VM : scp del paquete .zip
VM --> Orq : paquete recibido
Orq -> VM : descomprimir en /var/www/vhosts/<host>/public y publicar vhost
VM --> Orq : Apache recargado
Orq --> API : persistir instancia ACTIVA
API --> Usuario : 200 con los datos de la instancia

@enduml
