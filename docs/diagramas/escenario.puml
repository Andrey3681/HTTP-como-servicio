@startuml escenario
skinparam monochrome true
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangleBorderThickness 1
skinparam nodeBorderThickness 1

title Diagrama de Contexto - HTTPaaS

actor "Usuario" as user
cloud "Internet" as wan

package "Equipo anfitrión" {
  node "Navegador" as browser
  node "Orquestador HTTPaaS\nAPI REST y consola web (:8080)" as orch
  node "Oracle VirtualBox\nVBoxManage" as vbox
}

package "Red host-only\nsubred derivada, por ejemplo 192.168.57.0/24" as net {
  node "VM ns\nDebian 13 + Bind9\nzona cloud.local.\nIP fija .10" as dns
  node "VM ApacheServer\nplantilla Apache\nIP fija .11\nApacheServer.vdi (multiattach)" as tmpl
  node "Instancias\nApache + disco diferencial\nDHCP .100-.199\n<host>.cloud.local" as inst
}

user --> browser
browser --> orch : HTTP
orch --> vbox : crea y opera las VM
orch --> dns : registra y lista A (nsupdate/dig)
orch --> inst : SSH/SCP (despliegue y operación)
vbox --> wan : NAT temporal durante la preparación
tmpl --> inst : discos diferenciales
inst --> dns : resolución de nombres

@enduml
