@startuml escenario
!theme plain
skinparam componentStyle rectangle

package "Equipo Anfitrión (Host)" {
  [Orquestador Go\n(HTTPaaS Core :8080)] as Core
}

package "Red Interna / Host-Only (192.168.10.0/24)" {
  node "VM: ns (Debian 13.0)\n192.168.10.10" as VMDNS {
    [Servidor DNS Bind9\nZona: cloud.local.] as Bind9
  }

  node "Instancia 1: paisajes\n192.168.10.30" as VM1 {
    [Apache Web Server\n/var/www/html (archivos.zip)] as Apache1
  }

  node "Instancia 2: negocios\n192.168.10.31" as VM2 {
    [Apache Web Server\n/var/www/html (pagina.zip)] as Apache2
  }
}

database "Almacenamiento VirtualBox" {
  [ApacheServer.vdi\n(modo multiattach)] as BaseDisk
  [Diferencial paisajes.vdi] as Diff1
  [Diferencial negocios.vdi] as Diff2
}

Core --> VMDNS : Actualización DNS Dinámica (RFC 2136 / SSH)
Core --> VM1 : Creación y Despliegue
Core --> VM2 : Creación y Despliegue

BaseDisk ..> Diff1 : Base compartida
BaseDisk ..> Diff2 : Base compartida
Diff1 --> VM1
Diff2 --> VM2

Bind9 ..> Apache1 : Resuelve paisajes.cloud.local.
Bind9 ..> Apache2 : Resuelve negocios.cloud.local.

@enduml

