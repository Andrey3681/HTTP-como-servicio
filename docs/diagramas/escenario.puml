@startuml escenario
skinparam monochrome true
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangleBorderThickness 1
skinparam nodeBorderThickness 1

title Diagrama de Escenario - HTTPaaS

node "Equipo Anfitrión\nVirtualBox\nOrquestador HTTPaaS (Go)" as host

rectangle "Red interna cloudnet\n192.168.10.0/24" as net {

  node "VM DNS - ns\nDebian 13 (CLI)\nBind9\n192.168.10.10/24\nzona cloud.local." as dns

  node "PLANTILLA ApacheServer\nDebian 13 (CLI) + Apache HTTPD\nGuest Additions\nApacheServer.vdi (multiattach)" as tmpl

  node "INSTANCIAS DINÁMICAS\nCreadas desde plantilla\nDiscos diferenciales (multiattach)\n192.168.10.[30..254]\n<host>.cloud.local" as inst

  node "Aplicación Web de Gestión\nInterfaz Web + API REST\nOrquestación y despliegue" as webapp
}

host -- net : 192.168.10.1 (host-only)
net -- dns
net -- tmpl
net -- inst
net -- webapp

tmpl --> inst : clonación / uso multiattach
webapp --> dns : registro dinámico (nsupdate)
webapp --> inst : despliegue .zip a /var/www/html/
webapp --> tmpl : aprovisionamiento

@enduml
